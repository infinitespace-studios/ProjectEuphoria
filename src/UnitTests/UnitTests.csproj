<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Define platform detection properties -->
    <IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</IsWindows>
    <IsOSX>$([MSBuild]::IsOSPlatform('OSX'))</IsOSX>
    <IsLinux>$([MSBuild]::IsOSPlatform('Linux'))</IsLinux>

    <!-- Set target framework based on platform -->
    <TargetFramework Condition="$(IsWindows)">net9.0-windows</TargetFramework>
    <TargetFramework Condition="!$(IsWindows)">net9.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Platform-specific MonoGame packages -->
  <ItemGroup Condition="$(IsWindows)">
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup Condition="$(IsOSX) OR $(IsLinux)">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.v3.core" Version="3.1.0" />
    <PackageReference Include="xunit.v3.assert" Version="3.1.0" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.1.0" />
    <PackageReference Include="Xunit.StaFact" Version="3.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Code\**\*.cs" />
  </ItemGroup>

</Project>